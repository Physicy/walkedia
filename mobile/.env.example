# Copie ce fichier en `.env` et renseigne tes propres valeurs (jamais commit).
# Project URL et anon key : Supabase → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Rien à mettre ici pour Google/Apple : useAuth.ts délègue tout le flux OAuth
# à Supabase (supabase.auth.signInWithOAuth). Le Client ID + Secret Google et
# le Service ID Apple se configurent côté dashboard Supabase
# (Authentication → Providers), pas dans ce fichier — voir README.md.
